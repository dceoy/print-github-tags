#!/usr/bin/env bash
#
# Tiny command to fetch repository tags or releases from GitHub

set -Eeuo pipefail

[[ "${1:-}" = '--debug' ]] && set -x && shift 1

COMMAND_NAME='print-github-tags'
COMMAND_VERSION='v1.0.0'
RELEASE=0
LATEST=0
TAR=0
ZIP=0
COOLDOWN=''
OWNER_REPO=''

print_version() {
  echo "${COMMAND_NAME}: ${COMMAND_VERSION}"
}

print_usage() {
  cat <<'USAGE'
Tiny command to fetch repository tags or releases from GitHub

Usage:
  print-github-tags -h|--help
  print-github-tags -v|--version
  print-github-tags [--release] [--latest] [--cooldown <duration>] [--tar|--zip] <owner>/<repo>

Options:
  -h, --help        Print usage
  -v, --version     Print version information
  --release         Print only releases
  --latest          Print the latest release, or the first tag returned by the GitHub API
  --cooldown        Exclude releases published within the given Nh, Nd, or Nw cooldown
  --tar             Print tar file URLs (.tar.gz)
  --zip             Print zip file URLs (.zip)

Example:
  $ print-github-tags --release --latest --tar curl/curl
USAGE
}

abort() {
  echo "${COMMAND_NAME}: ${*}" >&2
  exit 1
}

is_valid_owner_repo() {
  local owner_repo="${1}"
  local owner repo

  [[ "${owner_repo}" =~ ^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$ ]] || return 1

  owner="${owner_repo%%/*}"
  repo="${owner_repo#*/}"

  [[ "${owner}" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?$ ]] || return 1
  [[ "${repo}" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
}

print_items() {
  local item

  while IFS= read -r item; do
    [[ -n "${item}" ]] || continue
    if [[ ${TAR} -eq 1 ]]; then
      printf 'https://github.com/%s/archive/%s.tar.gz\n' "${OWNER_REPO}" "${item}"
    elif [[ ${ZIP} -eq 1 ]]; then
      printf 'https://github.com/%s/archive/%s.zip\n' "${OWNER_REPO}" "${item}"
    else
      printf '%s\n' "${item}"
    fi
  done
}

while [[ $# -gt 0 ]]; do
  case "${1}" in
    '-v' | '--version' )
      print_version && exit 0
      ;;
    '-h' | '--help' )
      print_usage && exit 0
      ;;
    '--release' )
      RELEASE=1 && shift 1
      ;;
    '--latest' )
      LATEST=1 && shift 1
      ;;
    '--cooldown' )
      [[ $# -ge 2 ]] || abort '--cooldown requires a duration'
      COOLDOWN="${2}" && shift 2
      ;;
    '--tar' )
      [[ ${ZIP} -ne 0 ]] && abort '--tar and --zip are mutually exclusive'
      TAR=1 && shift 1
      ;;
    '--zip' )
      [[ ${TAR} -ne 0 ]] && abort '--tar and --zip are mutually exclusive'
      ZIP=1 && shift 1
      ;;
    * )
      if [[ "${1:0:1}" = '-' ]]; then
        abort "invalid option \`${1}\`"
      elif [[ -n "${OWNER_REPO}" ]]; then
        abort "unexpected argument \`${1}\`"
      elif is_valid_owner_repo "${1}"; then
        OWNER_REPO="${1}" && shift 1
      else
        abort "invalid repository format \`${1}\`; expected <owner>/<repo>"
      fi
      ;;
  esac
done

[[ -z "${OWNER_REPO}" ]] && print_usage && exit 1

if [[ -n "${COOLDOWN}" ]]; then
  [[ ${RELEASE} -eq 1 ]] || abort '--cooldown requires --release'
  [[ "${COOLDOWN}" =~ ^[1-9][0-9]*[hdw]$ ]] || abort "invalid cooldown duration \`${COOLDOWN}\`; expected <positive integer>[h|d|w]"
  cooldown_value="${COOLDOWN%?}"
  cooldown_unit="${COOLDOWN: -1}"
  case "${cooldown_unit}" in
    h ) COOLDOWN_SECONDS=$((10#${cooldown_value} * 3600)) ;;
    d ) COOLDOWN_SECONDS=$((10#${cooldown_value} * 86400)) ;;
    w ) COOLDOWN_SECONDS=$((10#${cooldown_value} * 604800)) ;;
  esac
  command -v jq >/dev/null 2>&1 || abort '--cooldown requires jq'
  NOW_EPOCH="$(date -u +%s)"
  CUTOFF_EPOCH=$((NOW_EPOCH - COOLDOWN_SECONDS))
fi

if [[ ${RELEASE} -eq 1 ]]; then
  if [[ ${LATEST} -eq 1 && -z "${COOLDOWN}" ]]; then
    API_URL="https://api.github.com/repos/${OWNER_REPO}/releases/latest"
  else
    API_URL="https://api.github.com/repos/${OWNER_REPO}/releases?per_page=100"
  fi
  KEY='tag_name'
else
  API_URL="https://api.github.com/repos/${OWNER_REPO}/tags?per_page=100"
  KEY='name'
fi

RESPONSE=$(curl -fsSL "${API_URL}")
if [[ -n "${COOLDOWN}" ]]; then
  if [[ ${LATEST} -eq 1 ]]; then
    ITEMS=$(printf '%s\n' "${RESPONSE}" | jq --argjson cutoff "${CUTOFF_EPOCH}" -r '
      [
        .[]
        | select(.published_at != null)
        | select((.published_at | fromdateiso8601) <= $cutoff)
        | select(.draft == false and .prerelease == false)
      ]
      | if length == 0 then empty else max_by(.created_at | fromdateiso8601) | .tag_name end
    ')
  else
    ITEMS=$(printf '%s\n' "${RESPONSE}" | jq --argjson cutoff "${CUTOFF_EPOCH}" -r '
      .[]
      | select(.published_at != null)
      | select((.published_at | fromdateiso8601) <= $cutoff)
      | .tag_name
    ')
  fi
else
  ITEMS=$(printf '%s\n' "${RESPONSE}" | grep "\"${KEY}\":" | cut -d '"' -f 4 || true)

  if [[ ${LATEST} -eq 1 ]]; then
    ITEMS=$(printf '%s\n' "${ITEMS}" | head -n 1)
  fi
fi

printf '%s\n' "${ITEMS}" | print_items
